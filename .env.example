# ==============================================================================
# Event Planner & Budget Tracker - Environment Variables (Vercel + Neon Postgres)
# ==============================================================================

# 1. Neon Database (Dapatkan dari neon.tech -> Project -> Connection Details)
# DATABASE_URL = koneksi "Pooled" (dipakai aplikasi saat berjalan)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL = koneksi "Direct" (dipakai Prisma CLI untuk migrasi, lewat prisma.config.ts)
DIRECT_URL=postgresql://neondb_owner:your_password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 2. Secret key untuk sesi Auth.js (buat string acak, misal: openssl rand -base64 32)
AUTH_SECRET=buat_kunci_rahasia_acak_minimal_32_karakter_bebas

# 3. Opsional: akun demo untuk review lokal (dipakai seed + tombol autofill login).
# Kosongkan di production; tombol autofill tidak pernah tampil saat production.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo12345
